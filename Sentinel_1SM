  })
);


/***************************************
 * Export ASC and DES SM for each site
 * One CSV per site
 ***************************************/


// 1️⃣ Define your site manually
var mySite = ee.Feature(ee.Geometry.Point([15.0247981, 40.9339868]), {id: 'MySite'}); 
// <-- Change the coordinates here for the site you want

// 2️⃣ Name of the CSV files
var ascFileName = '1_ASC';  // change this manually
var desFileName = '1_DES';  // change this manually


// 4️⃣ Function to export time series for a single site
var exportSiteSM = function(siteFeature, imgCol, fileName){
  var smTimeSeries = imgCol.map(function(img){
    var meanVal = img.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: siteFeature.geometry(),
      scale: 30
    }).get(img.bandNames().get(0)); // get the first band value
    
    return ee.Feature(null, {
      date: img.date().format('YYYY-MM-dd'),
      SM: meanVal
    });
  });
  
  // Export the CSV
  Export.table.toDrive({
    collection: smTimeSeries,
    description: fileName,
    fileNamePrefix: fileName,
    fileFormat: 'CSV'
  });
};

exportSiteSM(mySite, asc_sm_abs, ascFileName);
exportSiteSM(mySite, des_sm_abs, desFileName);
